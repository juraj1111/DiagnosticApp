<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_menu_avatar"
            android:background="@android:color/white"
            android:padding="12dp"
            android:contentDescription="Patient avatar"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/patientIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pacient #0001"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/patientInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vek • Pohlavie"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/classificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:padding="6dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/protocolCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Počet protokolov"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>