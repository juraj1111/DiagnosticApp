<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.VoiceTasksActivity">

    <!-- Top Bar for Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <!-- Back Button with Arrow -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"/>

        <!-- Title Centered Horizontally -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Voice tasks"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginLeft="-60dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 11 Task Buttons -->
    <Button
        android:id="@+id/btnTask1"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask2"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 2"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask3"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 3"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask4"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 4"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask5"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 5"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask6"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 6"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask7"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 7"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask8"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 8"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask9"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 9"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask10"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 10"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnTask11"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Task 11"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp" />

</LinearLayout>
