<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Protocol Name and Type Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/protocolNameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hlasový protokol"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/protocolTypeBadge1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hlasový"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:background="#E0E0E0"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/protocolTypeBadge2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vlastný"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:background="#E0E0E0"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Progress and Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/protocolProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 10 úloh dokončených"
                    android:textSize="14sp"
                    android:textColor="#666666"/>

                <!-- Evaluation Status Badge -->
                <TextView
                    android:id="@+id/evaluationStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zdravý"
                    android:textSize="12sp"
                    android:textColor="#22C55E"
                    android:background="#DCFCE7"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="16dp"
                    android:visibility="visible"/>

                <!-- Evaluation Percentage -->
                <TextView
                    android:id="@+id/evaluationPercentageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="95%"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Chevron Icon -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            android:rotation="180"
            android:layout_marginStart="16dp"
            android:contentDescription="Open protocol"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>